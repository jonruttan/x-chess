; bundle.xon -- what this bundle is.

(name "chess")

; Helium, plus exactly the libraries this bundle imports and nothing
; ambient: the terminal and the clock, none of the tower.
(dialect he)

(requires-release "v0.65.0")

; The window board draws with the graphics library.
(requires-bundle "gfx" "v0.2.0" "jonruttan/x-lib-gfx")

(entry run)
